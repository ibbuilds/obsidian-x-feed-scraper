{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ibbuilds/source-scraper/blob/main/schemas/ndjson-v1.schema.json",
  "title": "Source Scraper NDJSON line v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataset",
    "projectId",
    "record"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataset": {
      "enum": [
        "entities",
        "observations",
        "changes",
        "alerts"
      ]
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "record": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
