{
  "name": "discovery-engine",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Extensible local knowledge ingestion, research and curation engine",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/obsidian-plugin"
  ],
  "scripts": {
    "sync": "node --experimental-strip-types apps/collector/cli.ts sync",
    "cli": "node --experimental-strip-types apps/collector/cli.ts",
    "serve": "node --experimental-strip-types apps/collector/cli.ts serve",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "build": "npm run build -w @discovery-engine/obsidian-plugin",
    "package": "npm run build && node apps/obsidian-plugin/package.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "fflate": "^0.8.2"
  },
  "license": "MIT"
}
