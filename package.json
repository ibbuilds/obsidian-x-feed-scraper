{
  "name": "source-scraper",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "JSON-first, source-independent data collection, curation and change tracking",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "apps/obsidian-plugin"
  ],
  "scripts": {
    "build:cli": "node scripts/build-cli.mjs",
    "build:obsidian": "npm run build -w @discovery-engine/obsidian-plugin",
    "build": "npm run build:cli && npm run build:obsidian",
    "package": "npm run build && node apps/obsidian-plugin/package.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "node scripts/ci-smoke.mjs",
    "legacy:cli": "node --experimental-strip-types apps/collector/cli.ts",
    "legacy:serve": "node --experimental-strip-types apps/collector/cli.ts serve"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "fflate": "^0.8.2"
  },
  "license": "MIT",
  "bin": {
    "source-scraper": "dist/source-scraper.mjs"
  },
  "files": [
    "dist/source-scraper.mjs",
    "LICENSE",
    "README.md"
  ]
}
